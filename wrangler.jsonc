{
  // Cloudflare Workers + Static Assets. Build first (npm run build), then `npx wrangler deploy`.
  "name": "aangan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 06:00 IST every day: builds reminders and applies late fees (needs SUPABASE_SERVICE_ROLE_KEY).
  "triggers": { "crons": ["30 0 * * *"] },
  "observability": { "enabled": true },
  // Runtime variables are managed in the Cloudflare dashboard or with `npx wrangler secret put <NAME>`
  // (ANTHROPIC_API_KEY, SUPABASE_SERVICE_ROLE_KEY, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY).
  // keep_vars stops a deploy from wiping variables set in the dashboard.
  "keep_vars": true
}
